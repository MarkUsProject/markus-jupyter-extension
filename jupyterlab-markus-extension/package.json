{
  "name": "jupyterlab-markus-extension",
  "version": "0.1.0",
  "description": "JupyterLab extension to submit notebook to backend server",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension"
  ],
  "license": "MIT",
  "author": "Tianshu",
  "main": "lib/jupyterlab-markus-extension.js",
  "types": "lib/jupyterlab-markus-extension.d.ts",
  "style": "style/index.css",
  "files": [
    "lib/**/*",
    "style/**/*",
    "src/**/*",
    "schema/*.json"
  ],
  "scripts": {
    "build": "pnpm run build:lib && pnpm run build:labextension:dev",
    "build:prod": "pnpm run clean && pnpm run build:lib:prod && pnpm run build:labextension",
    "build:labextension": "jupyter-builder build .",
    "build:labextension:dev": "jupyter-builder build --development True .",
    "build:lib": "tsc --sourceMap",
    "build:lib:prod": "tsc",
    "clean": "pnpm run clean:lib",
    "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
    "clean:all": "rimraf lib tsconfig.tsbuildinfo jupyterlab_markus_extension/labextension",
    "watch": "tsc -w --sourceMap",
    "test": "jest"
  },
  "dependencies": {
    "@jupyterlab/application": "^4.0.0",
    "@jupyterlab/apputils": "^4.0.0",
    "@jupyterlab/coreutils": "^6.5.4",
    "@jupyterlab/mainmenu": "^4.0.0",
    "@jupyterlab/notebook": "^4.0.0",
    "@jupyterlab/rendermime-interfaces": "^3.8.0",
    "@jupyterlab/settingregistry": "^4.0.0",
    "@lumino/widgets": "^2.1.0"
  },
  "devDependencies": {
    "@jupyter/builder": "^1.2.0",
    "@jupyterlab/core-meta": "^4.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "css-loader": "^7.1.4",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "rimraf": "^5.0.1",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.12",
    "typescript": "~5.7.3"
  },
  "jupyterlab": {
    "extension": true,
    "outputDir": "jupyterlab_markus_extension/labextension",
    "schemaDir": "schema"
  }
}
