{
  "compilerOptions": {
    "target": "ES2018",
    "module": "esnext",
    "lib": ["DOM", "ES2018", "ES2020"],
    "jsx": "react",
    "rootDir": "src",
    "outDir": "lib",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "composite": true,
    "types": []
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "lib"]
}
